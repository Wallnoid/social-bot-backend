# ==============================================================================
# Social Bot Backend — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Django
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_SETTINGS_MODULE=config.settings.local
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/social_bot

# PostgreSQL container settings (used by docker-compose)
POSTGRES_DB=social_bot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/1

# ------------------------------------------------------------------------------
# Celery
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend URL used in links sent by email (placeholder until the frontend exists)
FRONTEND_URL=http://localhost:3000

# The refresh token travels in an httpOnly cookie that only the API host receives, so the
# frontend and the API must share a base domain (app.example.com / api.example.com), and
# every subdomain of that domain must be trusted: they all count as the same site.
# Production always sends it as Secure; set false only to try it over plain HTTP elsewhere.
AUTH_REFRESH_COOKIE_SECURE=false
# Reverse proxies in front of the API (0 = none). Needed for the rate limits to tell clients apart
NUM_PROXIES=0

# Seconds a password link stays valid (604800 = 7 days)
PASSWORD_RESET_TIMEOUT=604800

# Seconds an invitation to join a business stays valid (604800 = 7 days)
INVITATION_TIMEOUT=604800

# The files that clients send are saved the first time someone opens them, and deleted after
# MESSAGE_FILE_RETENTION_DAYS. They are copies of what Meta gave: Meta keeps them only a few days.
# MEDIA_ROOT is the folder they go to; empty means media/ in the project. To keep them on another
# disk, mount it in that folder in every service that saves or deletes files (web and celery-worker).
MEDIA_ROOT=
MESSAGE_FILE_MAX_BYTES=16777216
MESSAGE_FILE_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# Email
# Local prints emails to the console unless EMAIL_BACKEND is set to SMTP.
# Use either SSL (port 465) or TLS/STARTTLS (port 587), never both.
# ------------------------------------------------------------------------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.hostinger.com
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_USE_TLS=False
# EMAIL_TIMEOUT=10
# EMAIL_HOST_USER=contact@wanps.tech
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Social Bot <contact@wanps.tech>

# Key that encrypts channel tokens and Meta App secrets stored in the database (wanps-core).
# Required. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it makes the stored tokens unreadable: they must be entered again.
WANPS_ENCRYPTION_KEY=

# Process the messages of the clients (and the bot's replies) in the Celery worker instead of inside
# the webhook request. Recommended: a slow AI inside the request makes Meta retry the delivery.
# The celery-worker service must be running. An account can override it in the Django admin.
WANPS_ASYNC=true

# Minutes the bot stays silent in a chat after a person replies from the inbox. After that, with no
# new reply of a person, the bot answers the client again.
BOT_RESUME_AFTER_MINUTES=60

# The time zone in which the bot tells the date and the time to the clients.
BUSINESS_TIME_ZONE=America/Guayaquil

# A client who insists on messages unrelated to the business: the bot warns from the second
# fault and stops answering them at the last one. The faults expire after the hours given, and a
# second block within those hours lasts longer.
BOT_MAX_MESSAGES_PER_HOUR=20
BOT_MAX_STRIKES=5
BOT_WARN_FROM_STRIKE=2
BOT_STRIKES_EXPIRE_HOURS=24
BOT_BLOCK_MINUTES=60
BOT_REPEAT_BLOCK_MINUTES=1440

# Development only: password of the demo users created by `python manage.py seed_demo`.
# Use a throwaway one, not a real password.
SEED_DEMO_PASSWORD=
# Development only: answer the messages sent to Meta without calling it, to try the frontend
# with the demo accounts (a text with #fail is rejected).
META_FAKE=false
